# ============================================================
# POPPER-PROOF COURT — Environment Variables Template
# Copy this file to `.env` and fill in your real keys.
# NEVER commit .env to git. (.gitignore protects it.)
# ============================================================

# ---------- LLM Providers ----------
# OpenAI: powers the Judge agent (o3) and Defender (gpt-5/4o)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_JUDGE_MODEL=o3
OPENAI_DEFENDER_MODEL=gpt-4o

# Anthropic: powers the Prosecutor agent (Claude Sonnet 4.5)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_PROSECUTOR_MODEL=claude-sonnet-4-5-20250929

# ---------- Voice / SFX ----------
# ElevenLabs: 3 distinct voices for Prosecutor / Defender / Judge + gavel SFX
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_PROSECUTOR_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_DEFENDER_VOICE_ID=AZnzlk1XvdvUeBnXmlld
ELEVENLABS_JUDGE_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ---------- Literature Search ----------
# Tavily: real-time web search for fresh evidence (sponsor — venue host!)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Semantic Scholar: 200M+ papers (free, no key required for low rate)
SEMANTIC_SCHOLAR_API_KEY=

# ---------- Backend ----------
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=POPPER-PROOF COURT

# ---------- Storage ----------
CHROMA_PERSIST_DIR=./chroma_db
SQLITE_PATH=./data/cases.db

# ---------- Optional: Observability ----------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=popper-proof-court
